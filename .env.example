# ─────────────────────────────────────────────────────────────
# Wruch Personal — variáveis de ambiente (copie para ".env")
# NUNCA publique o arquivo .env nem o coloque dentro de public_html.
# ─────────────────────────────────────────────────────────────

APP_NAME="Wruch Personal"
APP_URL=https://wruchpersonal.com
APP_ENV=production
APP_DEBUG=false
APP_TIMEZONE=America/Sao_Paulo
# Gere com: php cron/generate-key.php
APP_KEY=
FORCE_HTTPS=true
# Pasta privada para fotos, vídeos, sessões e logs (fora do public_html)
STORAGE_PATH=/home/USUARIO/wruch/storage

# Banco de dados (MySQL/MariaDB do cPanel)
DB_DRIVER=mysql
DB_HOST=localhost
DB_PORT=3306
DB_NAME=usuario_wruch
DB_USER=usuario_wruch
DB_PASS=

# Papéis definidos SOMENTE aqui (separe vários e-mails por vírgula).
# Só recebem a permissão depois de confirmar o e-mail na plataforma.
TRAINER_EMAILS=renanrdw@gmail.com
DEVELOPER_EMAILS=

# E-mail transacional (smtp | mail | log)
# HostGator: crie uma conta como nao-responda@wruchpersonal.com no cPanel → Contas de e-mail.
MAIL_TRANSPORT=smtp
MAIL_HOST=mail.wruchpersonal.com
MAIL_PORT=465
MAIL_ENCRYPTION=ssl
MAIL_USER=nao-responda@wruchpersonal.com
MAIL_PASS=
MAIL_FROM=nao-responda@wruchpersonal.com
MAIL_FROM_NAME="Wruch Personal"
# Para onde vão os avisos do treinador antes de o Renan criar a conta dele
TRAINER_NOTIFY_EMAIL=renanrdw@gmail.com

# Login com Google (console.cloud.google.com → Credenciais → ID do cliente OAuth "Aplicativo da Web")
# URI de redirecionamento autorizado: https://wruchpersonal.com/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Login com Apple (developer.apple.com → Services ID + chave "Sign in with Apple")
# Return URL: https://wruchpersonal.com/auth/apple/callback
APPLE_CLIENT_ID=
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY_PATH=/home/USUARIO/wruch/keys/AuthKey_XXXXXX.p8

# Mercado Pago (mercadopago.com.br/developers → Suas integrações)
MP_ACCESS_TOKEN=
MP_PUBLIC_KEY=
# Webhooks → Configurar notificações → "Assinatura secreta"
# URL: https://wruchpersonal.com/webhooks/mercadopago
# Eventos: Pagamentos, Planos e assinaturas (subscription_preapproval e subscription_authorized_payment)
MP_WEBHOOK_SECRET=
MP_STATEMENT_DESCRIPTOR=WRUCHPERSONAL

# Opcional: permite rodar o cron por URL (https://wruchpersonal.com/cron?token=...)
CRON_HTTP_TOKEN=
